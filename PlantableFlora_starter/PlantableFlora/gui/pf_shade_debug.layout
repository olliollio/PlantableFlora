FrameWidgetClass PF_ShadeDebugRoot {
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass PF_ShadeDebugPanel {
   ignorepointer 1
   color 0 0 0 0.55
   position 20 150
   size 620 110
   valign bottom_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
   {
    MultilineTextWidgetClass PF_ShadeDebugText {
     ignorepointer 1
     color 1 1 1 1
     position 10 8
     size 600 94
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     font "gui/fonts/sdf_MetronBook24"
     "outline size" 1
     "outline color" 0 0 0 1
     "exact text" 1
     "exact text size" 16
     wrap 1
    }
   }
  }
 }
}
